brez.top {

    handle_errors {
        root * /var/www/breztop_web/dist
        rewrite * /404.html
        file_server
    }

    root * /var/www/breztop_web/dist
    file_server

    @hidden path_regexp hidden (^|/)\.
    respond @hidden 404

    @personal path /personal-match-site /personal-match-site/*
    header @personal {
        X-Robots-Tag "noindex, nofollow, noarchive"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
    }

    header {
        Cache-Control "public, max-age=3600"
    }
}
